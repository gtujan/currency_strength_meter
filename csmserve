#!/usr/bin/env bash
# csmserve run|stop|restart|status|logs  [extra args passed to server.py]
# Thin launcher (macOS / Linux / WSL / Git Bash); the logic lives in csmserve.py.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do   # resolve symlinks portably (no readlink -f on stock macOS)
  T="$(readlink "$SRC")"
  case "$T" in /*) SRC="$T" ;; *) SRC="$(dirname "$SRC")/$T" ;; esac
done
DIR="$(cd "$(dirname "$SRC")" && pwd)"
PY=""
for c in "$DIR/.venv/bin/python" "$DIR/.venv/Scripts/python.exe"; do [ -x "$c" ] && PY="$c" && break; done
[ -n "$PY" ] || PY="$(command -v python3 || command -v python)"
[ -n "$PY" ] || { echo "python not found" >&2; exit 1; }
exec "$PY" "$DIR/csmserve.py" "$@"
